     {
      "call": "pair_with_host",
      "raised": {
       "type": "RemoteEngineError",
       "message": "This host only lets its owner's own Tailscale computers pair without a code. Enter the pairing code shown there instead."
      }
     }
    ]
   },
   {
    "name": "owners_computer",
    "client": "pair_with_host(tailscale=True)",
    "outcomes": [
     {
      "call": "pair_with_host",
      "returned": {
       "token": "<token#1>",
       "device_id": "<device_id#1>",
       "host_name": "studio",
       "fingerprint": "<fingerprint#1>",
       "alternates": [
        "192.168.1.20",
        "100.101.102.103"
       ],
       "via": "tailscale"
      }
     }
    ]
   }
  ]
 },
