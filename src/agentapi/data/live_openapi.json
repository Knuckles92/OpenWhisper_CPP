    "/v1/filters": {
      "post": {
        "summary": "Create Filter",
        "description": "Lease a text filter: ``{\"url\", \"stage\", \"timeout_ms\"?}``; renew within 60 s.",
        "operationId": "create_filter_lease",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 2048,
                    "minLength": 1,
                    "description": "Your filter's address on this computer."
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "before_cleanup",
                      "after_cleanup"
                    ]
                  },
                  "timeout_ms": {
                    "type": "integer",
                    "description": "How long to wait for a reply."
                  }
                },
                "type": "object",
                "required": [
                  "url",
                  "stage"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
