{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "fiorivoce",
  "version-string": "0.1.0",
  "builtin-baseline": "4702e381dbbd9b54d3f7e1eb565cd8981c1814cd",
  "dependencies": [
    "boost-asio",
    "boost-beast",
    "catch2",
    "curl",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swresample"
      ]
    },
    {
      "name": "minizip-ng",
      "default-features": false,
      "features": [
        "zlib"
      ]
    },
    "nlohmann-json",
    "openssl",
    "pcre2",
    "pocketfft",
    "portaudio",
    "pugixml",
    {
      "name": "sqlite3",
      "features": [
        "fts5",
        "json1"
      ]
    },
    {
      "name": "wil",
      "platform": "windows"
    },
    "zlib"
  ]
}
